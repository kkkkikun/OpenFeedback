# Caddy configuration for OpenFeedback.
#
# The public host is taken from the environment so the same file serves an
# IP address or a hostname:
#   OF_PUBLIC_HOST=https://feedback.example.com   (hostname)
#   OF_PUBLIC_HOST=https://203.0.113.10            (IP address)
#
# The `shortlived` certificate profile is required for IP-address
# certificates and also works for hostnames. These certificates live about
# six days; Caddy renews them automatically, well before they expire.

{
	email {$ACME_EMAIL:admin@example.com}

	# The named volumes are mounted at /data and /config. Caddy's defaults
	# are under /root/.local/share/caddy, which lives in the container's
	# writable layer — so without these two lines every container recreate
	# would throw away the certificate and the ACME account, and the server
	# would have to re-register with Let's Encrypt on every deployment.
	data_dir /data
	config_dir /config

	# Clients that connect by IP address do not send an SNI: RFC 6066 forbids
	# putting an IP literal in the Server Name extension. Caddy therefore has
	# no name to match the site against, finds no certificate, and answers the
	# handshake with "tlsv1 alert internal error" — the phone's HTTPS client
	# would fail exactly the same way.
	#
	# default_sni gives Caddy a name to fall back to, which makes the handshake
	# succeed for IP clients. It must be the same identifier the certificate
	# was issued for, without a scheme or path.
	default_sni {$OF_DEFAULT_SNI:203.0.113.10}

	cert_issuer acme {
		profile shortlived
	}
}

{$OF_PUBLIC_HOST:https://feedback.example.com} {
	encode zstd gzip

	# Uploaded screenshots can be a few MB; the app's own limits are 2 MB per
	# file and 3 files per submission.
	request_body {
		max_size 12MB
	}

	# The SDK's Maven repository. A host app declares this one URL and pins
	# an exact version:
	#   maven { url = uri("https://<host>/maven/") }
	#   implementation("com.kkkkikun.openfeedback:openfeedback-compose:0.1.0")
	handle_path /maven/* {
		root * /srv/maven
		file_server
	}

	# The admin UI and the API are both behind this host.
	#
	# `header_up` replaces the header instead of appending to it. Caddy's
	# default would append the real address to whatever the client sent, and
	# the app reads the first entry of X-Forwarded-For, so a client could
	# otherwise spoof its way past the rate limit.
	reverse_proxy api:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}

	log {
		output stdout
		format console
	}
}
