# Copy to .env on the server. Never commit a filled-in copy.
#
# The admin password is only used to create the first admin account when the
# database is empty. Change it afterwards.

OF_ADMIN_USERNAME=admin
OF_ADMIN_PASSWORD=change-me-before-first-start

# Public origin of the service, used for links in the admin UI.
OF_BASE_URL=https://feedback.example.com

# The public host clients connect to, with its scheme. An IP address works:
# Let's Encrypt issues short-lived certificates for IP addresses.
OF_PUBLIC_HOST=https://feedback.example.com

# The SNI fallback Caddy uses for clients that connect by IP address.
# Such clients send no SNI (RFC 6066 forbids an IP literal there), so without
# this Caddy finds no certificate and the TLS handshake fails.
# This is the host part of OF_PUBLIC_HOST, without scheme or port.
OF_DEFAULT_SNI=feedback.example.com

# Set to false only when the service is behind a proxy you control.
OF_TRUSTED_PROXY_HEADERS=true

# Limits
OF_MAX_ATTACHMENT_BYTES=2097152
OF_MAX_ATTACHMENTS=3
OF_SUBMISSIONS_PER_HOUR=10

# Keep the cookie Secure. Turn off only for local HTTP testing.
OF_COOKIE_SECURE=true
OF_SESSION_TTL_HOURS=12

# A random string. It salts the stored client-IP hashes.
OF_IP_HASH_SALT=change-me-to-a-long-random-string
